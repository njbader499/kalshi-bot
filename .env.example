# Copy to .env and fill in yourself. Never paste these into chat.
ENV=demo
KALSHI_KEY_ID=
# Forward slashes work on Windows too. Lock the file with scripts\setup.ps1 (icacls).
KALSHI_PRIVATE_KEY_PATH=C:/Users/YOU/.kalshi/demo_key.pem
# Must stay false unless you are physically in the US. VPNs violate Kalshi's terms.
LOCATION_OK=false
I_ACCEPT_REAL_MONEY_RISK=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
